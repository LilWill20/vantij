{
  "routes": [
    {
      "route": "/css/*",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/js/*",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/admin",
      "rewrite": "/admin.html",
      "allowedRoles": [
        "creator"
      ]
    },
    {
      "route": "/admin.html",
      "allowedRoles": [
        "creator"
      ]
    },
    {
      "route": "/api/videos",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "creator"
      ]
    },
    {
      "route": "/api/videos/*/complete",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "creator"
      ]
    },
    {
      "route": "/api/videos/*/transcribe",
      "allowedRoles": [
        "creator",
        "consumer"
      ]
    },
    {
      "route": "/login",
      "rewrite": "/login.html"
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout"
    }
  ],
  "rolesSource": "/api/GetRoles",
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/login"
    },
    "403": {
      "rewrite": "/login.html"
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/css/*",
      "/js/*",
      "/*.{png,jpg,jpeg,gif,ico,svg,mp4,webm}"
    ]
  },
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/<TENANT_ID>/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      }
    }
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self'; img-src 'self' data: https:; media-src 'self' https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
  }
}
