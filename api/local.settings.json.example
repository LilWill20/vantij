{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",

    "COSMOS_ENDPOINT": "https://<your-cosmos>.documents.azure.com:443/",
    "COSMOS_KEY": "<cosmos-primary-key>",
    "COSMOS_DATABASE": "vantij",

    "STORAGE_ACCOUNT": "<your-storage-account>",
    "STORAGE_KEY": "<storage-account-key>",
    "VIDEO_CONTAINER": "videos",

    "SPEECH_KEY": "<azure-ai-speech-key>",
    "SPEECH_REGION": "uksouth",

    "LANGUAGE_ENDPOINT": "https://<your-language>.cognitiveservices.azure.com/",
    "LANGUAGE_KEY": "<azure-ai-language-key>"
  },
  "Host": {
    "CORS": "*"
  }
}
